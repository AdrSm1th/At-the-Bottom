<Window x:Class="At_the_Bottom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:At_the_Bottom.Converters"
        xmlns:views="clr-namespace:At_the_Bottom.Views"
        Title="At the Bottom" 
        Height="600" Width="800"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:TileTypeToBrushConverter x:Key="TileTypeToBrush" />
    </Window.Resources>

    <Grid Background="Black">
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PixelLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding PixelTop}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="{Binding Size}" Height="{Binding Size}"
                        Fill="{Binding Type, Converter={StaticResource TileTypeToBrush}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Entities}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PixelLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding PixelTop}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Size}" Height="{Binding Size}">
                        <TextBlock Text="{Binding Symbol}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontFamily="Consolas"
                                   Foreground="White" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>


        <views:BattleView>
            <views:BattleView.Style>
                <Style TargetType="{x:Type views:BattleView}">

                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInBattle}"
                             Value="True">

                            <Setter Property="Visibility"
                            Value="Visible"/>

                        </DataTrigger>
                    </Style.Triggers>

                </Style>
            </views:BattleView.Style>
        </views:BattleView>


        <Border Background="#E5111111">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGameOver}"
                             Value="True">
                            <Setter Property="Visibility"
                            Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Конец игры"
               FontSize="36"
               Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>