<Window x:Class="At_the_Bottom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:At_the_Bottom.Converters"
        xmlns:views="clr-namespace:At_the_Bottom.Views"
        Title="At the Bottom" 
        Height="600" Width="800"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:TileTypeToBrushConverter x:Key="TileTypeToBrush"/>
    </Window.Resources>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
            Background="#252D38"
            Padding="12">

            <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center">

                <TextBlock Text="Каэль"
                Foreground="White"
                FontSize="18"
                Margin="0,0,20,0"/>

                <TextBlock Text="{Binding PlayerHealth,
                StringFormat='HP: {0}'}"
                Foreground="White"/>

                <ProgressBar Width="100"
                    Height="15"
                    Margin="8,0,20,0"
                    Maximum="{Binding PlayerMaxHealth}"
                    Value="{Binding PlayerHealth,
                            Mode=OneWay}"/>

                <TextBlock Text="{Binding PlayerLevel,
                    StringFormat='Уровень: {0}'}"
                    Foreground="White"
                    Margin="0,0,20,0"/>

                <TextBlock Text="{Binding PlayerExperience,
                    StringFormat='XP: {0}'}"
                    Foreground="White"/>

                <ProgressBar Width="100"
                    Height="15"
                    Margin="8,0,20,0"
                    Maximum="{Binding PlayerExperienceToNextLevel}"
                    Value="{Binding PlayerExperience,
                            Mode=OneWay}"/>

                <TextBlock Text="{Binding PlayerGold,
                    StringFormat='Золото: {0}'}"
                    Foreground="Gold"/>

                <TextBlock Text="{Binding PlayerPotions,
                    StringFormat='Зелья: {0}'}"
                    Foreground="LightGreen"
                    Margin="20,0,0,0"/>


            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Tiles}" Grid.Row="1">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PixelLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding PixelTop}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="{Binding Size}" Height="{Binding Size}"
                        Fill="{Binding Type, Converter={StaticResource TileTypeToBrush}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Entities}" Grid.Row="1">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding PixelLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding PixelTop}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Size}" Height="{Binding Size}">
                        <TextBlock Text="{Binding Symbol}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontFamily="Consolas"
                                   Foreground="White" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>


        <views:BattleView Grid.RowSpan="2">
            <views:BattleView.Style>
                <Style TargetType="{x:Type views:BattleView}">

                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInBattle}"
                             Value="True">

                            <Setter Property="Visibility"
                            Value="Visible"/>

                        </DataTrigger>
                    </Style.Triggers>

                </Style>
            </views:BattleView.Style>
        </views:BattleView>

        <views:LevelUpView Grid.RowSpan="2">
            <views:LevelUpView.Style>
                <Style TargetType="{x:Type views:LevelUpView}">

                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLevelUpOpen}"
                             Value="True">

                            <Setter Property="Visibility"
                            Value="Visible"/>

                        </DataTrigger>
                    </Style.Triggers>

                </Style>
            </views:LevelUpView.Style>
        </views:LevelUpView>

        <Border Background="#E5111111" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                    Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGameOver}"
                             Value="True">
                            <Setter Property="Visibility"
                            Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="Конец игры"
               FontSize="36"
               Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>