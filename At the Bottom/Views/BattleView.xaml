<UserControl x:Class="At_the_Bottom.Views.BattleView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
               Text="Сражение"
               FontSize="32"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,30,0,0"/>

        <!-- Участники боя -->
        <StackPanel Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <TextBlock Text="{Binding CurrentBattle.EnemyName}"
                   Foreground="White"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

            <ProgressBar Width="250"
                   Height="20"
                   Maximum="{Binding CurrentBattle.EnemyMaxHealth}"
                   Value="{Binding CurrentBattle.EnemyHealth, Mode=OneWay}"
                   Margin="0,10,0,0"/>

            <TextBlock Text="{Binding CurrentBattle.PlayerName}"
                   Foreground="White"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="0,70,0,0"/>

            <ProgressBar Width="250"
                   Height="20"
                   Maximum="{Binding CurrentBattle.PlayerMaxHealth}"
                   Value="{Binding CurrentBattle.PlayerHealth, Mode=OneWay}"
                   Margin="0,10,0,0"/>

        </StackPanel>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,30">

            <Button Content="Атака"
                Command="{Binding AttackCommand}"
                Width="110"
                Height="40"
                Margin="5"/>

            <Button Content="Защита"
                Command="{Binding DefendCommand}"
                Width="110"
                Height="40"
                Margin="5"/>

            <Button Content="Зелье"
                Command="{Binding UsePotionCommand}"
                Width="110"
                Height="40"
                Margin="5"/>

        </StackPanel>
    </Grid>
</UserControl>