<UserControl x:Class="At_the_Bottom.Views.LevelUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1E1E1E">

        <StackPanel Width="350"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Повышение уровня!"
                       FontSize="30"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <TextBlock Text="{Binding PlayerLevel,
                       StringFormat='Уровень {0}'}"
                       FontSize="22"
                       Foreground="White"
                       TextAlignment="Center"/>

            <TextBlock Text="{Binding UpgradePoints,
                       StringFormat='Очков улучшения: {0}'}"
                       FontSize="16"
                       Foreground="LightGray"
                       TextAlignment="Center"
                       Margin="0,10,0,30"/>

            <Button Content="+5 к максимальному здоровью"
                    Command="{Binding UpgradeHealthCommand}"
                    Height="50"
                    Margin="0,5"/>

            <Button Content="+1 к урону"
                    Command="{Binding UpgradeDamageCommand}"
                    Height="50"
                    Margin="0,5"/>

            <Button Content="+1 к защите"
                    Command="{Binding UpgradeDefenseCommand}"
                    Height="50"
                    Margin="0,5"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">

                <TextBlock Text="HP: "
                           Foreground="White"/>

                <TextBlock Text="{Binding PlayerMaxHealth}"
                           Foreground="White"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Урон: "
                           Foreground="White"/>

                <TextBlock Text="{Binding PlayerDamage}"
                           Foreground="White"
                           Margin="0,0,20,0"/>

                <TextBlock Text="Защита: "
                           Foreground="White"/>

                <TextBlock Text="{Binding PlayerDefense}"
                           Foreground="White"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
